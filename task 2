nums = [5, 5, 5]         # вывод: Второго по величине элемента нет
ma = max(nums)
for i in nums:
    if i == ma: nums.remove(i)
if ma in nums: nums.remove(ma)
if len(nums)>0: print(max(nums))
else: print('второго по величине элемента нет')