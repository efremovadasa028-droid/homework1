words = ["кот", "пёс", "кот", "кот", "ёж", "пёс", "кот"]
groups={}
for w in words:
    key = w[0]
    if key not in groups:
        groups[key] = []
    groups[key].append(w)
ans = []
for key, word in groups.items():
    ans.append([len(word), word])
ans.sort(reverse = True)
k = 0
for i in ans:
    print(i[0],'-', i[1][0])
    k += 1
    if k == 3: break